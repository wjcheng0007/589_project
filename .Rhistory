library(spatstat)
# Convert elevation raster to spatstat pixel image (if it's not already)
DATA$Elevation <- as.im(DATA$Elevation)
# Create a mask of valid (non-NA) elevation pixels
mask <- solutionset(!is.na(DATA$Elevation))
library(spatstat)
# Convert elevation raster to spatstat pixel image (if it's not already)
DATA$Elevation <- as.im(DATA$Elevation)
# Identify animal points inside the elevation mask
inside_mask <- inside.owin(x = DATA$Animal$X, y = DATA$Animal$Y, w = mask)
