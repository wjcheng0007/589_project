library(spatstat)
# Step 1: Create point pattern object (ppp) for animals
animal_ppp <- ppp(x = DATA$Animal$X,
y = DATA$Animal$Y,
window = custom_win)  # Use same custom window from earlier
# Step 2: Compute nearest neighbor distances
nn_distances <- nndist(animal_ppp)
# Step 3: Add distances as marks to the animal point pattern
marks(animal_ppp) <- nn_distances
# Step 4: Plot the animal pattern colored by nearest neighbor distance
plot(animal_ppp, main = "Animal Observations Marked by Nearest Neighbour Distance")
# Step 5: Identify the most isolated animal observation
most_isolated_index <- which.max(nn_distances)
# Optional: If you want to pull a column from DATA$Animal (e.g., an ID or species)
# Replace "SomeIDColumn" with an actual column name like "occurrenceID" or "species"
most_isolated_animal <- DATA$Animal[most_isolated_index, ]
cat("The most isolated animal observation is:\n")
print(most_isolated_animal)
library(spatstat)
# Step 1: Create point pattern object (ppp) for animals
animal_ppp <- ppp(x = DATA$Animal$X,
y = DATA$Animal$Y,
window = custom_win)  # Use same custom window from earlier
nn_distances <- nndist(animal_ppp)
marks(animal_ppp) <- nn_distances
plot(animal_ppp, main = "Animal Observations Marked by Nearest Neighbour Distance")
# Step 1: Median elevation - province vs. animal locations
median_bc <- median(DATA$Elevation$v, na.rm = TRUE)
elev_at_animals <- interp.im(DATA$Elevation, DATA$Animal$X, DATA$Animal$Y)
median_animals <- median(elev_at_animals, na.rm = TRUE)
cat("Median elevation in BC:", median_bc, "\n")
cat("Median elevation at animal locations:", median_animals, "\n")
# Step 2: KDE - full province vs. animal locations
elev_all <- DATA$Elevation$v
elev_all <- elev_all[!is.na(elev_all)]
elev_at_animals <- elev_at_animals[!is.na(elev_at_animals)]
kde_all <- density(elev_all)
kde_animals <- density(elev_at_animals)
# Step 3: Plot KDEs
plot(kde_all,
main = "Elevation Distributions: BC vs. Animal Locations",
xlab = "Elevation (meters)",
ylab = "Density",
col = "gray40", lwd = 2,
xlim = range(c(kde_all$x, kde_animals$x)))
lines(kde_animals, col = "blue", lwd = 2)
# Step 4: Add legend
legend("topright",
legend = c("BC (All Pixels)", "Animal Observations"),
col = c("gray40", "blue"),
lwd = 2)
# Step 5: Identify highest and lowest elevation animal observations
elev_at_animals <- interp.im(DATA$Elevation, DATA$Animal$X, DATA$Animal$Y)
max_index <- which.max(elev_at_animals)
min_index <- which.min(elev_at_animals)
highest_animal <- DATA$Animal[max_index, ]
lowest_animal  <- DATA$Animal[min_index, ]
cat("Highest elevation animal observation:\n")
print(highest_animal)
cat("Lowest elevation animal observation:\n")
print(lowest_animal)
