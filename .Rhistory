library(sf)
library(spatstat.geom)
library(sp)
# Import the BC park locations dataset.
load("BC_Parks.Rda")
# Convert the data to a ppp object
coords <- DATA$Parks[,c("X","Y")]
marks <- DATA$Parks$Region
window_sf <- st_as_sf(DATA$Window)
window <- as.owin(window_sf)
parks_ppp <- ppp(x = coords$X,
y = coords$Y,
window = window,
marks = marks)
# Run plot() on the resulting ppp object.
plot(parks_ppp)
# rescale the data
pp.parks.km <- rescale(parks_ppp, s = 1000, unitname = "km")
area_km <- area.owin(Window(pp.parks.km))
n_parks <- npoints(parks_ppp)
intensity <- n_parks/area_km
intensity
library(spatstat.explore)
# For example, a 10x10 grid
nx <- 10
ny <- 10
# Count points in each quadrat
Q <- quadratcount(parks_ppp, nx=nx, ny=ny)
intensity(Q)
quadrat.test(Q)
plot(parks_ppp , main = "Parks and Quadrat Counts", pch = 16, cols = "black")
# Overlay the quadrat grid
plot(Q, add = TRUE, col = "red")
plot(intensity(Q, image = T))
plot(parks_ppp, pch = 16,cex = 0.9,cols = "white",add = T)
plot(parks_ppp, pch = 16,cex = 0.6, col = "black", add = TRUE)
# Kernel density estimation using Diggle’s rule
kde <- density(parks_ppp, sigma = bw.ppl)
# Plot intensity map with points
plot(kde, main = "Kernel Density of Park Intensity")
plot(parks_ppp, pch = 16,cex = 0.9,cols = "white",add = T)
plot(parks_ppp, pch = 16,cex = 0.6, col = "black", add = TRUE)
bw_cv <- bw.ppl(parks_ppp)
kde_cv <- scanLRTS(parks_ppp,r= bw_cv)
plot(kde_cv, main = "Intensity Estimate (bw.ppl cross-validation)")
hotspot_mask <- eval.im(pchisq(kde_cv,df = 1, lower.tail = F))
plot(Window(parks_ppp), add = TRUE, border = "darkgreen", lwd = 1)
plot(hotspot_mask)
plot(Window(parks_ppp), add = TRUE,border = "darkgreen",  lwd = 1)
# Divide elevation image into quartiles (4 categories)
Zcut <- cut(DATA$Elevation, breaks = quantile(DATA$Elevation, probs = 0:4 / 4, type = 2))
parks<- unmark(parks_ppp)
quadratcount(parks,tess=tess(image=Zcut))
rho <- rhohat(parks,DATA$Elevation)
plot(rho)
lambda <- density(parks,sigma=bw.ppl,positive=TRUE)
# Generate Monte Carlo simulations
en_K <- envelope(parks, Kinhom,simulate=expression(rpoispp(lambda)), correction = "border", rank=1,nsim = 19,fix.n=TRUE)
# Plot the K-function with envelope
plot(en_K, main = "Ripley’s K-function with CSR Envelopes")
lambda <- density(parks,sigma=bw.ppl(parks),positive=TRUE)
pcf_hom <- envelope(parks, pcf,simulate= expression(rpoispp(lambda)),rank=1, nsim = 19)
plot(pcf_hom)
pcf_inhom <- envelope(parks, pcfinhom, nsim = 19,simulate= (expression(rpoispp(lambda))),rank=1)
plot(pcf_inhom)
# Compute the spatial intensity (points per km²) for animal observations
pp.animal.km <- rescale(animal_ppp, s = 1000, unitname = "km")
area_km <- area.owin(Window(pp.animal.km))
n_animals <- npoints(animal_ppp)
intensity <- n_animals / area_km
intensity
# Compute the spatial intensity (points per km²) for animal observations
pp.animal.km <- rescale(animal_ppp, s = 1000, unitname = "km")
area_km <- area.owin(Window(pp.animal.km))
n_animals <- npoints(animal_ppp)
intensity <- n_animals / area_km
intensity
plot(animal_ppp , pch = 16, cols = "black")
# Overlay the quadrat grid
plot(Q, add = TRUE, col = "red")
# Plot quadrat-based intensity and overlay animal locations
plot(intensity(Q, image = TRUE))
plot(animal_ppp, pch = 16, cex = 0.9, cols = "white", add = TRUE)
plot(animal_ppp, pch = 16, cex = 0.6, col = "black", add = TRUE)
# Kernel density estimation using Diggle’s rule
kde <- density(animal_ppp, sigma = bw.ppl)
# Plot kernel density map with animal points
plot(kde, main = "Kernel Density of Animal Observation Intensity")
plot(animal_ppp, pch = 16, cex = 0.9, cols = "white", add = TRUE)
plot(animal_ppp, pch = 16, cex = 0.6, col = "black", add = TRUE)
# Plot quadrat-based intensity and overlay animal locations
plot(intensity(Q, image = TRUE))
plot(animal_ppp, pch = 16, cex = 0.3, col = "black", add = TRUE)
# Kernel density estimation using Diggle’s rule
kde <- density(animal_ppp, sigma = bw.ppl)
# Plot kernel density map with animal points
plot(kde, main = "Kernel Density of Animal Observation Intensity")
plot(animal_ppp, pch = 16, cex = 0.3, col = "black", add = TRUE)
# Perform kernel intensity estimation with cross-validated bandwidth and identify hotspots for animal observations
bw_cv <- bw.ppl(animal_ppp)
kde_cv <- scanLRTS(animal_ppp, r = bw_cv)
plot(kde_cv, main = "Intensity Estimate (bw.ppl cross-validation)")
hotspot_mask <- eval.im(pchisq(kde_cv, df = 1, lower.tail = FALSE))
plot(Window(animal_ppp), add = TRUE, border = "darkgreen", lwd = 1)
plot(hotspot_mask)
plot(Window(animal_ppp), add = TRUE, border = "darkgreen", lwd = 1)
# Estimate the relationship between animal intensity and elevation using rhohat
Zcut <- cut(DATA$Elevation, breaks = quantile(DATA$Elevation, probs = 0:4 / 4, type = 2))
animals <- unmark(animal_ppp)
quadratcount(animals, tess = tess(image = Zcut))
rho <- rhohat(animals, DATA$Elevation)
plot(rho)
# Estimate the relationship between animal intensity and elevation using rhohat
Zcut <- cut(DATA$Elevation, breaks = quantile(DATA$Elevation, probs = 0:4 / 4, type = 2))
animals <- unmark(animal_ppp)
quadratcount(animals, tess = tess(image = Zcut))
rho <- rhohat(animals, DATA$Elevation)
plot(rho)
plot(rho, xlim = c(-100, 3000), main = "Intensity vs Elevation", xlab = "Elevation (m)", ylab = "Intensity")
# Estimate the relationship between animal intensity and elevation using rhohat
Zcut <- cut(DATA$Elevation, breaks = quantile(DATA$Elevation, probs = 0:4 / 4, type = 2))
animals <- unmark(animal_ppp)
quadratcount(animals, tess = tess(image = Zcut))
rho <- rhohat(animals, DATA$Elevation)
plot(rho)
plot(rho, xlim = c(-50, 3000), main = "Intensity vs Elevation", xlab = "Elevation (m)", ylab = "Intensity")
# Estimate the relationship between animal intensity and elevation using rhohat
Zcut <- cut(DATA$Elevation, breaks = quantile(DATA$Elevation, probs = 0:4 / 4, type = 2))
animals <- unmark(animal_ppp)
quadratcount(animals, tess = tess(image = Zcut))
rho <- rhohat(animals, DATA$Elevation)
plot(rho)
plot(rho, xlim = c(-30, 3000), main = "Intensity vs Elevation", xlab = "Elevation (m)", ylab = "Intensity")
# Estimate the relationship between animal intensity and elevation using rhohat
Zcut <- cut(DATA$Elevation, breaks = quantile(DATA$Elevation, probs = 0:4 / 4, type = 2))
animals <- unmark(animal_ppp)
quadratcount(animals, tess = tess(image = Zcut))
rho <- rhohat(animals, DATA$Elevation)
plot(rho)
plot(rho, xlim = c(-100, 3000), main = "Intensity vs Elevation", xlab = "Elevation (m)", ylab = "Intensity")
# Compute the inhomogeneous intensity surface for animal observations
lambda <- density(animal_ppp, sigma = bw.ppl, positive = TRUE)
# Generate Monte Carlo simulations for inhomogeneous K-function
en_K <- envelope(animal_ppp, Kinhom, simulate = expression(rpoispp(lambda)),
correction = "border", rank = 1, nsim = 19, fix.n = TRUE)
# Plot the K-function with simulation envelope
plot(en_K, main = "Ripley’s K-function with CSR Envelopes (Animal Observations)")
# Compute the inhomogeneous intensity surface for animal observations
